# ─────────────────────────────────────────────────────────────────────────────
# Fireflies clone — environment template
# Copy to .env and adjust:  cp .env.example .env
# Every variable the app reads is listed here. There are no hidden defaults
# that differ from these values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────────────────────

# SQLAlchemy connection URL. SQLite by default (the brief specifies SQLite).
# Swapping to Postgres is a URL change only — no code changes.
# Docker compose overrides this to point at the shared volume.
DATABASE_URL=sqlite:///./fireflies.db

# Comma-separated origins allowed by CORS. Never "*" in a deployed environment.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI provider for summaries, action items, keywords and Q&A.
#   mock      — deterministic, offline, zero-cost. THE DEFAULT and what the demo runs on.
#   openai    — requires AI_API_KEY
#   anthropic — requires AI_API_KEY
# On any LLM failure the app falls back to `mock` rather than erroring (T-29.7).
AI_PROVIDER=mock

# Only read when AI_PROVIDER is openai or anthropic. Leave blank for mock.
# NEVER commit a real value — .env is gitignored.
AI_API_KEY=

# Where uploaded transcripts and sample audio live, relative to backend/.
MEDIA_DIR=./media

# Upload ceiling enforced on BOTH client and server (T-26.13).
MAX_UPLOAD_MB=10

# Anchor date for relative seed data ("2 meetings today, 1 yesterday", T-05.3).
# Must match the clock Playwright pins in e2e (T-39.6) or date assertions
# such as "Today"/"Yesterday" break on any other calendar day.
# Leave blank to anchor to the real current date.
SEED_ANCHOR_DATE=2026-07-26T09:00:00Z

# ── Frontend ─────────────────────────────────────────────────────────────────

# Base URL the browser uses to reach the API. Must be reachable from the
# BROWSER, not from inside the container — so it stays localhost under compose.
NEXT_PUBLIC_API_URL=http://localhost:8000
