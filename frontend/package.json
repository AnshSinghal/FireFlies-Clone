    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^4.1.10"
